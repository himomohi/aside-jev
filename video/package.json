{
  "name": "aside-jev-speed-duel",
  "version": "1.0.0",
  "description": "A measured comparison of Jev client lifecycle strategies, localized in English and Korean",
  "repository": {
    "type": "git",
    "url": "https://github.com/himomohi/aside-jev"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.526",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.526",
    "@remotion/bundler": "4.0.526",
    "@remotion/renderer": "4.0.526",
    "@remotion/transitions": "4.0.526"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.526",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "check": "eslint src && tsc",
    "stills": "node --require ./scripts/loopback-only.cjs scripts/render.mjs --stills",
